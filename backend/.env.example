# PrintForge backend — environment variables (architecture frozen v1.2)
# Copy to .env and fill in real values. Never commit .env.
#
# "prod-required" = enforced at boot by src/common/config/env.validation.ts
# when NODE_ENV=production. Unset/blank is fine for development and test.
# Full matrix + provisioning notes: docs/ops/ENVIRONMENT.md
#
# Render (production):
#   Root Directory: backend
#   Build: npm ci --include=dev && npx prisma generate && npm run build
#   Start: npx prisma migrate deploy && npm run start:prod
#   DATABASE_URL: Render PostgreSQL INTERNAL connection string (not the
#   External Database URL). Never commit real values. Never log this value.
#   Do not run prisma migrate reset | db push | migrate dev on production.
#   Do not run prisma:seed or prisma:seed:tenant-bootstrap on Render.

# --- App ---
NODE_ENV=development
PORT=4000
# FRONTEND_URL — prod-required. Exact storefront origin (no trailing slash);
# primary CORS origin. Production also always allows
# https://www.abcmanufactures.com and https://abcmanufactures.com.
# Local Vite (localhost/127.0.0.1 :5173 and :4173) is also allowed.
# Must be same-site with BACKEND_URL for the SameSite=Strict refresh cookie.
FRONTEND_URL=http://localhost:5173
# BACKEND_URL — prod-required. Public API origin (Razorpay webhook URL, absolute links).
# Production: https://api.abcmanufactures.com
# Merchant commerce webhook: {BACKEND_URL}/api/v1/payments/webhook
BACKEND_URL=http://localhost:4000

# --- Database ---
# Always required (every environment).
DATABASE_URL=postgresql://user:password@localhost:5432/printforge?schema=public

# --- Auth / JWT ---
# Secrets always required (every environment). Use long random strings.
# The refresh secret is REFRESH_TOKEN_SECRET — there is no JWT_REFRESH_SECRET.
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me
REFRESH_TOKEN_EXPIRES_IN=30d
# Admin/super-admin refresh cookie. Shoppers keep REFRESH_TOKEN_EXPIRES_IN.
ADMIN_REFRESH_TOKEN_EXPIRES_IN=12h

# --- Razorpay merchant commerce --- (all three prod-required)
# rzp_test_* keys in development; rzp_live_* only in production.
# Webhook dashboard URL: {BACKEND_URL}/api/v1/payments/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Razorpay SaaS Billing (all three prod-required) ---
# PrintForge's OWN subscription billing (Merchant -> PrintForge -> Razorpay
# Subscriptions) — a separate Razorpay account/keys from RAZORPAY_KEY_ID/
# KEY_SECRET/WEBHOOK_SECRET above (merchant commerce). Never reuse either
# set of credentials for the other.
# Webhook dashboard URL: {BACKEND_URL}/api/v1/webhooks/billing
RAZORPAY_SAAS_KEY_ID=
RAZORPAY_SAAS_KEY_SECRET=
RAZORPAY_SAAS_WEBHOOK_SECRET=

# --- Payment credential encryption (Phase 8, docs/saas/DECISIONS.md P8-D6) ---
# (prod-required) Single platform-wide AES-256-GCM master key that encrypts
# every merchant PaymentAccount's stored Razorpay credentials. Base64,
# MUST decode to exactly 32 bytes. Generate with:
#   openssl rand -base64 32
# There is no default/fallback — production refuses to boot without a
# valid value (backend/src/common/config/env.validation.ts), and nothing
# in this codebase ever hardcodes one. Never reuse this key for anything
# else; rotating it requires re-encrypting every PaymentAccount row (not
# automated — see docs/ops/ENVIRONMENT.md).
PAYMENT_CREDENTIALS_MASTER_KEY=

# --- Resend (email) --- (both prod-required)
# EMAIL_FROM_ADDRESS must be on a Resend-verified domain in production.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@printforge.in

# --- Cloudinary --- (all three prod-required)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Postal PIN lookup (optional) ---
# Defaults to https://api.pincodeapi.in/api/v1 when unset.
# POSTAL_LOOKUP_BASE_URL=

# --- Tenant enforcement flags (optional) ---
# Each module defaults to "advisory". Set to "enforced" only after Phase 4
# tenantId backfill is live for that module.
# TENANT_ENFORCEMENT_PRODUCTS=advisory
# TENANT_ENFORCEMENT_CART=advisory
# TENANT_ENFORCEMENT_CHECKOUT=advisory
# TENANT_ENFORCEMENT_ORDERS=advisory
# TENANT_ENFORCEMENT_PAYMENTS=advisory
# TENANT_ENFORCEMENT_INVOICES=advisory
# TENANT_ENFORCEMENT_COUPONS=advisory
# TENANT_ENFORCEMENT_REVIEWS=advisory
# TENANT_ENFORCEMENT_UPLOADS=advisory
# TENANT_ENFORCEMENT_APP_SETTING=advisory
# TENANT_ENFORCEMENT_NOTIFICATIONS=advisory

# --- Monitoring (§30) — OPTIONAL, recommended in production ---
# Sentry.init in main.ts is guarded by this, so unset is a valid no-op.
# Not enforced by env validation (error reporting must never block boot).
SENTRY_DSN=

# --- Local bootstrap only — NEVER set on Render / production ---
# seed-tenant-bootstrap.ts refuses NODE_ENV=production.
# SEED_TENANT_SLUG=
# SEED_STORE_SLUG=
# SEED_STORE_NAME=
# SEED_OWNER_EMAIL=
# SEED_OWNER_PASSWORD=
