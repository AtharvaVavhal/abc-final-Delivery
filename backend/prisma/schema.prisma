// PrintForge — Prisma schema
// Authoritative architecture: PrintForge SaaS Architecture v1.0 (FROZEN) +
// docs/saas/PRINTFORGE-SAAS-IMPLEMENTATION-MASTER-PLAN-v1.0.md (APPROVED).
// docs/architecture/BLUEPRINT-v1.2.md is SUPERSEDED (retained as history) per
// docs/saas/ACR-001-SUPERSEDE-BLUEPRINT-V1.2.md (approved 2026-09-06).
// Inline "§NN" comments below cite BLUEPRINT-v1.2 as historical provenance for
// the original single-tenant design; those sections are historical, not current
// authority. Schema changes follow the SaaS Master Plan's phased, additive,
// expand -> migrate -> contract discipline. Phase 1 appends the SaaS Foundation
// block at the end of this file (Tenant / Store / StoreDomain / TenantMembership
// + Plan / Subscription shells) additively — no existing model is changed.
// Phase 2a (docs/saas/PHASE-2-DECISION-RESOLUTION-AND-SPEC.md §C; DECISIONS.md
// v1.2) appends the SaaS Identity block (Customer) + the PlatformRole enum, and
// adds exactly one nullable column to `users` (platformRole) — no existing
// commerce table is changed, no customerId column is added anywhere (Phase 4),
// and no customer auth runtime exists (Phase 9/12).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

// Platform super-admin axis (SaaS Master Plan §8; decision P2-D1, ratified by
// G-12 — docs/saas/DECISIONS.md v1.2). A nullable `User.platformRole` field, not
// a boolean, so it stays extensible. Completely separate from `Role` and from
// TenantMembership (frozen SaaS invariant 4). Phase 2a adds the enum + column +
// PlatformGuard mechanism only — no route is platform-scoped until the Phase 5
// platform console. `Role { CUSTOMER, ADMIN }` above is unchanged.
enum PlatformRole {
  SUPER_ADMIN
}

enum CustomizationFieldType {
  TEXT
  LOGO_UPLOAD
  IMAGE_UPLOAD
  DESIGN_FILE_UPLOAD
  COLOR_SELECT
  INSTRUCTIONS
}

enum SurchargeType {
  NONE
  FLAT
  PER_CHARACTER
}

// Business state — §14's 9-value graph. Every transition is a
// compare-and-swap; see orders/state-machine/order-state-machine.ts.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// Payment-infrastructure state, per attempt — §12.1. Distinct from OrderStatus.
enum PaymentAttemptStatus {
  INITIATED
  CAPTURED
  FAILED
  ABANDONED
}

// §12.3 — durably-received / processed ledger for the two-phase webhook design.
// FAILED is the terminal dead-letter state, reached after the bounded retry
// budget is exhausted or a non-retryable error (e.g. a payment/amount
// mismatch whose payload will never succeed) — Phase 13.3.
enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  PROCESSING_FAILED
  IGNORED
  FAILED
}

// Phase 8 (P8-D3/P8-D6, docs/saas/DECISIONS.md) — merchant commerce payment
// providers. `RAZORPAY` is the only value today; extensible without a
// migration to the enum's own column type (Postgres `ALTER TYPE ... ADD
// VALUE` is a separate, not-yet-permitted shape under this repo's
// migration-safety guard — same G-10 constraint `SubscriptionEventType`'s
// own comment already documents — so a second provider, if it ever ships,
// is its own later decision, not assumed here).
enum PaymentProviderType {
  RAZORPAY
}

// Phase 8 (P8-3 architecture spec §4) — minimal 3-state PaymentAccount
// lifecycle. No hard delete — DISABLED is terminal-but-reversible, the same
// discipline TenantStatus/StoreStatus/Coupon.isActive already use elsewhere
// in this schema (invariant 19: destroying merchant data is never a side
// effect of a status change).
enum PaymentAccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum PaymentAccountMode {
  TEST
  LIVE
}

// Phase 7 — D7 SaaS Billing Webhooks wave (docs/saas/DECISIONS.md P7-D3
// Part B). Same status vocabulary as `WebhookEventStatus` above, by
// deliberate precedent — but its OWN enum, never a reuse of that one, so a
// future commerce-only change to `WebhookEventStatus` can never silently
// affect the separate SaaS-billing table this backs (`BillingWebhookEvent`,
// below — see that model's own comment for the full separation rationale).
enum BillingWebhookEventStatus {
  RECEIVED
  PROCESSED
  PROCESSING_FAILED
  IGNORED
  FAILED
}

// §12.2 — transactional outbox.
enum OutboxEventType {
  ORDER_PAID
  ORDER_STATUS_CHANGED
  PASSWORD_RESET_REQUESTED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// ─── Identity & Auth ────────────────────────────────────────────────────

// Single-address MVP folded directly onto users — no addresses table
// [RECONCILED, §15]. Never hard-deleted while owning any order (orders.userId
// is RESTRICT). tokenVersion only ever increments (§23).
model User {
  id           String @id @default(uuid())
  // Nullable since phone-OTP login (docs/architecture/PHONE-OTP-AUTH-DESIGN.md):
  // customers sign in by SMS code and may have no email. Staff accounts always
  // have both email and passwordHash (enforced in application logic).
  email        String? @unique
  passwordHash String?
  // Verified mobile number in E.164 ("+91XXXXXXXXXX"). Separate from the
  // legacy free-text `phone` profile field below, which is unverified and may
  // hold duplicates — never used for login.
  phoneE164       String?   @unique
  phoneVerifiedAt DateTime?

  role         Role          @default(CUSTOMER)
  // SaaS Identity (Phase 2a) — platform super-admin axis. Nullable, NO default:
  // null = not a platform admin. Checked only by PlatformGuard on
  // @PlatformOnly() routes (none exist yet — Phase 5). Independent of `role`
  // and of any TenantMembership (frozen SaaS invariant 4; Master Plan §8;
  // decision P2-D1/P2-D2). This is the ONLY column Phase 2a adds to `users`.
  platformRole PlatformRole?
  tokenVersion Int           @default(0)

  failedLoginAttempts    Int       @default(0)
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  phone        String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens      RefreshToken[]
  uploadedFiles      UploadedFile[]
  cart               Cart?
  orders             Order[]
  orderStatusChanges OrderStatusHistory[]
  idempotencyKeys    IdempotencyKey[]
  reviews            Review[]
  createdCoupons     Coupon[]
  couponUsages       CouponUsage[]

  // SaaS Foundation (Phase 1) — back-relations only; these add NO column to
  // `users` (Prisma virtual fields — the FK columns live on tenant_memberships).
  // User = platform/merchant identity (decision D5-a); a storefront Customer
  // (Phase 2) never gets a TenantMembership.
  tenantMemberships        TenantMembership[] @relation("TenantMembershipUser")
  invitedTenantMemberships TenantMembership[] @relation("TenantMembershipInvitedBy")

  // Phase 5 (W2) — back-relation only; adds NO column to `users`. A
  // PlatformAuditLog.actorUserId is always a SUPER_ADMIN acting on
  // /platform/* (decision P5-D3).
  platformAuditLogs PlatformAuditLog[]

  // Phase 5 (W6) — back-relations only; add NO column to `users`. Every
  // SupportSession.createdByUserId is a SUPER_ADMIN at creation time
  // (enforced in support-session.service.ts, not by a DB constraint —
  // platformRole is nullable/mutable, so a since-demoted admin's past
  // sessions still resolve correctly here); revokedByUserId is nullable
  // (a session may never be revoked — it can also simply expire).
  supportSessionsCreated SupportSession[] @relation("SupportSessionCreatedBy")
  supportSessionsRevoked SupportSession[] @relation("SupportSessionRevokedBy")

  // Phase 6 (W1) — back-relations only; add NO column to `users`. Same
  // shape/reasoning as the SupportSession pair immediately above:
  // createdByUserId is a SUPER_ADMIN at creation time (enforced in the
  // platform service, not a DB constraint); revokedByUserId is nullable
  // (an override may never be revoked).
  entitlementOverridesCreated TenantEntitlementOverride[] @relation("TenantEntitlementOverrideCreatedBy")
  entitlementOverridesRevoked TenantEntitlementOverride[] @relation("TenantEntitlementOverrideRevokedBy")

  @@map("users")
}

// Session persistence, rotation, revocation — §23. Never updated after
// revokedAt except by the chain-revocation sweep on reuse detection.
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// One row per SMS code sent. Only a keyed hash of the code is stored. Short
// lived — consumed, expired or exhausted rows are purged by a scheduled job.
model OtpChallenge {
  id         String    @id @default(uuid())
  phoneE164  String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  requestIp  String?
  createdAt  DateTime  @default(now())

  @@index([phoneE164, createdAt])
  @@index([createdAt])
  @@map("otp_challenges")
}

// ─── Catalog ────────────────────────────────────────────────────────────

// ─── Phase 4 (W3) — SaaS ownership columns, additive only ─────────────────
// Nullable tenantId/storeId/customerId-family scalar columns added across the
// commerce tables below (Master Plan W3: "ADD COLUMN ... NULL"). Plain
// scalars, no @relation yet — composite FKs are W6, NOT NULL is W7, and
// backfill is W4 (decision P4-D1, Option B). See
// docs/saas/PHASE-4-IMPLEMENTATION-REPORT.md.

// Flat, one nesting level (§8). Only active categories appear in the
// public storefront; isActive mirrors Product's pattern for soft-delete.
model Category {
  id               String  @id @default(uuid())
  name             String
  slug             String
  parentCategoryId String?
  isActive         Boolean @default(true)

  tenantId String
  storeId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentCategory  Category?  @relation("CategoryToCategory", fields: [parentCategoryId], references: [id])
  childCategories Category[] @relation("CategoryToCategory")
  products        Product[]
  coupons         Coupon[]

  @@index([parentCategoryId])
  @@index([tenantId])
  @@index([storeId])
  @@map("categories")
}

// Never hard-deleted once it appears in any OrderItem — isActive=false
// instead; propagates transitively to images/variants/fields (§8).
model Product {
  id             String  @id @default(uuid())
  categoryId     String
  name           String
  slug           String
  basePrice      Decimal @db.Decimal(10, 2)
  minQuantity    Int
  maxQuantity    Int?
  specifications Json?
  isActive       Boolean @default(true)

  // Denormalized from `reviews` — recomputed via a scoped aggregate inside
  // the same transaction as any review create/edit/status-change, never
  // computed at read time (PHASE-10-PROPOSAL.md §1.1/R7). avgRating stays
  // null until the first PUBLISHED review exists, so a product page can
  // render "No reviews yet" rather than a misleading 0.00.
  avgRating   Decimal? @db.Decimal(3, 2)
  reviewCount Int      @default(0)

  tenantId String
  storeId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images              ProductImage[]
  variants            ProductVariant[]
  customizationFields CustomizationField[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  reviews             Review[]

  @@index([categoryId])
  @@index([tenantId])
  @@index([storeId])
  @@map("products")
}

model ProductImage {
  id                 String  @id @default(uuid())
  productId          String
  cloudinaryPublicId String
  // Denormalized from the UploadedFile this image was created from
  // (products.service.ts's addImage()) so the read paths can compute a
  // working delivery URL (cloudinary.url()) with zero extra DB joins.
  // Every product image is 'upload'-delivered (public, unsigned) as of
  // this fix — see uploads.service.ts's create() — but this stores the
  // upload's actual values rather than assuming that, so a differently-
  // delivered file attached here still resolves to a correct URL.
  resourceType       String  @default("image")
  deliveryType       String  @default("upload")
  sortOrder          Int     @default(0)
  isPrimary          Boolean @default(false)

  tenantId String
  storeId  String?

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([tenantId])
  @@index([storeId])
  @@map("product_images")
}

// Flat list of concrete purchasable combinations — never a generated
// attribute matrix (§8).
model ProductVariant {
  id          String  @id @default(uuid())
  productId   String
  label       String
  priceDelta  Decimal  @db.Decimal(10, 2) @default(0)
  isAvailable Boolean @default(true)

  tenantId String
  storeId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id])
  cartItems CartItem[]

  @@unique([productId, label])
  @@index([productId])
  @@index([tenantId])
  @@index([storeId])
  @@map("product_variants")
}

// Per-product field definitions (§9). Pricing-critical values are typed
// columns, never buried in JSONB — surchargeType/surchargeAmount.
model CustomizationField {
  id              String                 @id @default(uuid())
  productId       String
  label           String
  type            CustomizationFieldType
  isRequired      Boolean                @default(false)
  sortOrder       Int                    @default(0)
  helpText        String?
  constraints     Json?
  surchargeType   SurchargeType          @default(NONE)
  surchargeAmount  Decimal                @db.Decimal(10, 2) @default(0)

  tenantId String
  storeId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product        Product                 @relation(fields: [productId], references: [id])
  cartItemValues CartItemCustomization[]

  @@index([productId])
  @@index([tenantId])
  @@index([storeId])
  @@map("customization_fields")
}

// ─── File Uploads ───────────────────────────────────────────────────────

// uploadedByUserId is non-nullable by design — login precedes upload, no
// guest-identity special case (§9/§22). Ownership re-verified on every
// referencing write.
model UploadedFile {
  id                 String @id @default(uuid())
  cloudinaryPublicId String @unique
  uploadedByUserId   String
  format             String
  bytes              Int
  resourceType       String
  deliveryType       String

  tenantId             String
  uploadedByCustomerId String?

  createdAt DateTime @default(now())

  uploadedBy      User                     @relation(fields: [uploadedByUserId], references: [id])
  cartItemValues  CartItemCustomization[]
  orderItemValues OrderItemCustomization[]

  @@index([uploadedByUserId])
  @@index([tenantId])
  @@index([uploadedByCustomerId])
  @@map("uploaded_files")
}

// ─── Cart ───────────────────────────────────────────────────────────────

// One open cart per user — always authenticated, no guest cart (§10).
model Cart {
  id     String @id @default(uuid())
  userId String @unique

  tenantId   String
  storeId    String?
  customerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]

  @@index([tenantId])
  @@index([storeId])
  @@index([customerId])
  @@map("carts")
}

// Duplicate lines allowed by design — no line-merging on duplicate add (§10).
model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int

  tenantId String
  storeId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart           Cart                    @relation(fields: [cartId], references: [id])
  product        Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant?         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  customizations CartItemCustomization[]

  @@index([cartId])
  @@index([tenantId])
  @@index([storeId])
  @@map("cart_items")
}

// Ownership of uploadedFileId re-verified at write time (§9 Business Rule 12).
model CartItemCustomization {
  id                   String  @id @default(uuid())
  cartItemId           String
  customizationFieldId String
  textValue            String?
  uploadedFileId       String?

  tenantId String
  storeId  String?

  cartItem           CartItem           @relation(fields: [cartItemId], references: [id])
  customizationField CustomizationField @relation(fields: [customizationFieldId], references: [id], onDelete: Restrict)
  uploadedFile       UploadedFile?      @relation(fields: [uploadedFileId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@map("cart_item_customizations")
}

// ─── Orders ─────────────────────────────────────────────────────────────

// Never hard-deleted; status only via CAS; shipping fields immutable after
// creation (§11, §24 invariant 6). razorpayOrderId's nullability alone
// represents "has a Razorpay order been created" — not a separate status (§12.1).
model Order {
  id          String      @id @default(uuid())
  orderNumber String
  userId      String
  status      OrderStatus @default(PENDING_PAYMENT)

  subtotal    Decimal @db.Decimal(10, 2)
  // Stored, not derived — checkout.service.ts used to compute this on read
  // as `total - subtotal`, which was only correct while discount was
  // hardcoded to zero (no coupons yet). Written once at order-creation time
  // from the same getShippingFeePaise() value that feeds computeOrderTotal,
  // and read back verbatim thereafter (docs/architecture/PHASE-10-PROPOSAL.md §2.5).
  shippingFee Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  currency    String  @default("INR")

  // Coupon snapshot (PHASE-10-PROPOSAL.md §2.1/C7) — couponId/couponCode
  // are nullable (most orders have no coupon); discountAmount is never
  // null, defaulting to 0 so `total = subtotal - discountAmount +
  // shippingFee` always holds structurally, matching how
  // PricingService.computeOrderTotal already defaults discountPaise to 0n
  // when omitted. couponCode is a denormalized snapshot (same reasoning as
  // OrderItem.productNameSnapshot) — display never needs a join back to a
  // coupons row that (unlike products) isn't even guaranteed to still
  // exist by identity if the FK were ever nulled out.
  couponId       String?
  couponCode     String?
  discountAmount Decimal @default(0) @db.Decimal(10, 2)

  // ─── Tax snapshot (Phase 13.4) ────────────────────────────────────────
  // Tax-INCLUSIVE pricing (pricing.service.ts / BLUEPRINT §4): the customer
  // pays `total`, and `total` is UNCHANGED by any tax configuration.
  // `taxAmount` is the GST component *extracted from within* the goods
  // value (subtotal − discountAmount) and stays 0.00 until a
  // client-confirmed rate is enabled in admin settings. `taxRateSnapshot`
  // (fractional, e.g. 0.1800 for 18%) and `taxBreakdown` (CGST/SGST/IGST
  // split — null until place-of-supply rules are confirmed) freeze the
  // treatment used at checkout so an invoice never re-derives tax from
  // current config. Invariant (INCLUSIVE): total = taxableAmount +
  // taxAmount + shippingFee. See checkout.service.ts.
  taxMode         String   @default("INCLUSIVE")
  taxableAmount   Decimal  @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(10, 2)
  taxRateSnapshot Decimal? @db.Decimal(5, 4)
  taxBreakdown    Json?

  razorpayOrderId String? @unique

  // Phase 8 (P8-3 architecture spec §2.3) — the merchant PaymentAccount
  // this order's payment was routed through, resolved server-side at
  // checkout from the order's own `storeId` and persisted once, never
  // re-resolved later (P8-3 §6: "resolve once, at checkout; persist the
  // FK; never re-resolve for the same order later"). Plain column,
  // deliberately NO Prisma `@relation` / DB foreign key — `orders` is a
  // table created by an EARLIER migration, so migration-safety.spec.ts's
  // G-19 rule applies exactly as it already did to
  // `Subscription.pendingPlanId` (P7-D1 Part … see that field's own
  // comment): the ONLY permitted change to a pre-existing table is a
  // single, purely nullable `ADD COLUMN`, no `DEFAULT`, no `NOT NULL` — a
  // real `ADD CONSTRAINT … FOREIGN KEY` is rejected outright for a table
  // not created in the same migration file. Referential integrity to
  // `PaymentAccount.id` is therefore enforced at the APPLICATION layer
  // (`PaymentAccountsService`/`CheckoutService`), not the database layer,
  // for this stage — same deviation, same reasoning, same precedent.
  paymentAccountId String?

  // Immutable shipping snapshot — copied from User at creation time, never a
  // live FK (§11 "Immutable shipping snapshot").
  shippingRecipientName String
  shippingPhone         String
  shippingAddressLine1  String
  shippingAddressLine2  String?
  shippingCity          String
  shippingState         String
  shippingPostalCode    String
  shippingCountry       String

  tenantId   String
  storeId    String?
  customerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  paymentAttempts PaymentAttempt[]
  statusHistory   OrderStatusHistory[]
  idempotencyKey  IdempotencyKey?
  // SET NULL, not RESTRICT (unlike products.categoryId): a coupon is
  // optional/incidental to an order's existence, and coupons are never
  // hard-deleted anyway (isActive=false is the retirement path) — nothing
  // about a coupon's lifecycle should ever be blocked by an order that
  // merely referenced it once (PHASE-10-PROPOSAL.md §2.1).
  coupon          Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponUsage     CouponUsage?
  invoice         Invoice?

  @@index([userId])
  @@index([status])
  @@index([couponId])
  @@index([tenantId])
  @@index([storeId])
  @@index([customerId])
  @@index([paymentAccountId])
  @@map("orders")
}

// ─── Invoicing (Phase 13.4) ─────────────────────────────────────────────

// One immutable invoice per order (orderId is @unique → creation is
// idempotent, no revisions in this phase). Every monetary field is a
// snapshot copied from the Order's own already-immutable financial columns
// at issue time; `sellerSnapshot` freezes the mutable admin-settings
// seller identity (legal name / address / GSTIN / state — empty strings
// until the client supplies them). Line items are read from the order's
// immutable OrderItem rows, never re-projected from live Product/Category.
// invoiceNumber comes from a DEDICATED counter (invoice_number_counter),
// never the order-number counter; prefix is admin-configurable
// (invoice.numberPrefix) and its statutory format is pending client
// confirmation.
model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String
  orderId       String   @unique
  issuedAt      DateTime @default(now())

  currency        String
  subtotal        Decimal  @db.Decimal(10, 2)
  discountAmount  Decimal  @db.Decimal(10, 2)
  shippingFee     Decimal  @db.Decimal(10, 2)
  taxableAmount   Decimal  @db.Decimal(10, 2)
  taxAmount       Decimal  @db.Decimal(10, 2)
  grandTotal      Decimal  @db.Decimal(10, 2)
  taxMode         String
  taxRateSnapshot Decimal? @db.Decimal(5, 4)
  taxBreakdown    Json?

  sellerSnapshot Json

  tenantId String

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([issuedAt])
  @@index([tenantId])
  @@map("invoices")
}

// Snapshotted lines — never recomputed retroactively (§13.G).
model OrderItem {
  id                   String  @id @default(uuid())
  orderId              String
  productId            String?
  productNameSnapshot  String
  variantLabelSnapshot String?
  unitPriceSnapshot    Decimal @db.Decimal(10, 2)
  quantity             Int
  lineTotal            Decimal @db.Decimal(10, 2)

  tenantId String
  storeId  String?

  order          Order                    @relation(fields: [orderId], references: [id])
  product        Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  customizations OrderItemCustomization[]
  reviews        Review[]

  @@index([orderId])
  @@index([tenantId])
  @@index([storeId])
  @@map("order_items")
}

// Referenced files never purged by the uploads orphan-cleanup poller (§24
// invariant 7).
model OrderItemCustomization {
  id                 String  @id @default(uuid())
  orderItemId        String
  fieldLabelSnapshot String
  textValue          String?
  uploadedFileId     String?

  tenantId String

  orderItem    OrderItem     @relation(fields: [orderItemId], references: [id])
  uploadedFile UploadedFile? @relation(fields: [uploadedFileId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("order_item_customizations")
}

// Every attempt against an order — replaces `payments` (§12.1). ≤1 CAPTURED
// attempt per order is DB-enforced via a partial unique index that Prisma's
// schema DSL cannot express natively:
//
//   CREATE UNIQUE INDEX payment_attempts_order_captured_unique
//     ON payment_attempts ("orderId") WHERE status = 'CAPTURED';
//
// TODO(payments): after the first `prisma migrate dev` generates the base
// migration for this model, hand-edit the generated migration.sql to add the
// statement above (Prisma will not regenerate/remove a manually-added SQL
// statement on subsequent migrations as long as it isn't reintroduced by a
// schema change to this model). Do NOT rely on application-level validation
// alone for this invariant — see final report.
model PaymentAttempt {
  id                String               @id @default(uuid())
  orderId           String
  razorpayOrderId   String
  razorpayPaymentId String?              @unique
  amountPaise       BigInt
  currency          String               @default("INR")
  status            PaymentAttemptStatus @default(INITIATED)
  failureCode       String?
  failureReason     String?
  method            String?
  rawPayload        Json?

  tenantId String

  // Phase 8 (P8-3 architecture spec §2.3) — same plain-column, no-FK
  // treatment as `Order.paymentAccountId` (see that field's own comment):
  // `payment_attempts` is a pre-existing table, so G-19 permits only a
  // bare nullable `ADD COLUMN`, never a new `ADD CONSTRAINT … FOREIGN
  // KEY`. Application-layer referential integrity only, for this stage.
  paymentAccountId String?

  createdAt  DateTime  @default(now())
  capturedAt DateTime?
  updatedAt  DateTime  @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@index([tenantId])
  @@index([paymentAccountId])
  @@map("payment_attempts")
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

// Records a refund triggered against a captured PaymentAttempt (Phase 7 —
// order cancellation, customer or admin-initiated). §12.5 as originally
// frozen states refunds are processed manually via the Razorpay dashboard
// with no in-app refund-initiation API in MVP; this table and the in-app
// trigger that writes to it are a deliberate, explicitly-authorized Phase 7
// extension beyond that MVP scope (see the Phase 7 completion report).
// PaymentAttempt.status intentionally stays CAPTURED (historically
// accurate) rather than gaining a REFUNDED value — this table is the
// source of truth for "money was returned," same separation of concerns
// as Order.status (business state) vs PaymentAttempt.status (payment-
// infrastructure state) in §12.1.
model Refund {
  id               String       @id @default(uuid())
  paymentAttemptId String
  razorpayRefundId String?      @unique
  amountPaise      BigInt
  status           RefundStatus @default(PENDING)
  reason           String?
  failureReason    String?

  tenantId String

  // Phase 8 (P8-3 architecture spec §2.3) — same plain-column, no-FK
  // treatment as `Order.paymentAccountId` (see that field's own comment):
  // `refunds` is a pre-existing table, G-19-restricted the same way.
  paymentAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@index([paymentAttemptId])
  @@index([tenantId])
  @@index([paymentAccountId])
  @@map("refunds")
}

// Append-only audit trail (§13.K/L).
model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String?
  note            String?

  tenantId              String
  changedByCustomerId   String?
  changedByMembershipId String?

  createdAt DateTime @default(now())

  order     Order @relation(fields: [orderId], references: [id])
  changedBy User? @relation(fields: [changedByUserId], references: [id])

  @@index([orderId])
  @@index([tenantId])
  @@map("order_status_history")
}

// ─── Payments infrastructure (internal-only, no REST surface — §20) ──────

// Inserted only after signature verification (§12.3). Retry bookkeeping
// (attempts / availableAt / lastError / processedAt) mirrors OutboxEvent's
// exactly — the webhook poller now uses the same bounded-retry +
// exponential-backoff + dead-letter policy the outbox poller already had
// (Phase 13.3).
model WebhookEvent {
  id              String             @id @default(uuid())
  razorpayEventId String             @unique
  payload         Json
  status          WebhookEventStatus @default(RECEIVED)

  // Phase 8 (P8-3 architecture spec §2.3/§9) — resolved DURING processing
  // only, never trusted from the raw payload (mirrors
  // `BillingWebhookEvent`'s own "never trust tenantId from the payload"
  // discipline, P7-D3 Part B). Same plain-column, no-FK treatment as
  // `Order.paymentAccountId` (see that field's own comment): `webhook_events`
  // is a pre-existing table, G-19-restricted the same way. NOT populated
  // by anything in this stage — no webhook processing changes yet (P8-4
  // scope; see the payment-accounts module's own doc comment).
  paymentAccountId String?

  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lastError   String?
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
  @@index([paymentAccountId])
  @@map("webhook_events")
}

// Phase 8 (P8-D3/P8-D6, docs/saas/DECISIONS.md; P8-3 architecture spec §2.1)
// — a merchant's own, independently-owned Razorpay account, per Store per
// Provider. Structurally distinct from PrintForge's own SaaS-billing
// `Subscription` (invariant 6) — never related to it, by design; see
// `money-flow-separation.spec.ts`.
//
// Store-owned (not Tenant-owned): `tenantId` is denormalized for isolation
// defense-in-depth (same convention as `Customer`/`StoreDomain`/
// `StoreSetting`), `storeId` is the real ownership FK. `@@unique([storeId,
// provider])` caps a store at one row per provider — never zero (a store
// may hold no PaymentAccount yet), never two for the SAME provider, but
// explicitly NOT one-provider-only: a second, distinct provider is a second
// row, not a schema change (P8-3 §2.1 "do not assume one provider").
//
// `credentialsEncrypted` is deliberately nullable — P8-4 shipped it unused
// (schema + lifecycle only); P8-5 populates it as an opaque AES-256-GCM
// blob (P8-D6, `CredentialEncryptionService`), written via
// `PaymentAccountsService.configureCredentials` and decrypted only inside
// `RazorpayAccountVerifierService` (the provider-adapter boundary) —
// `PaymentAccountsService` itself still only ever handles it as opaque
// ciphertext. No `credentialsKeyId` column — P8-D6
// ratified a single, platform-wide master key (one Render environment
// secret), not a KMS with per-record data keys, so there is exactly one
// key for every row to reference; a per-row key-reference column would be
// dead weight (P8-3 §2.1, explicit deviation from the Master Plan's
// original per-row-KMS-key sketch).
//
// Deliberately excluded (P8-3 §2.1 / P8-D3 Part F): no KYC field, no
// Route/linked-account id, no settlement-schedule field, no
// merchant-of-record flag, no split-payment/platform-fee field, no
// "default account" flag (moot while exactly one provider exists), no
// dedicated audit-event table (`TenantAuditLog` is reused instead).
model PaymentAccount {
  id       String @id @default(uuid())
  tenantId String
  storeId  String

  provider PaymentProviderType
  status   PaymentAccountStatus @default(PENDING)
  mode     PaymentAccountMode

  displayName String?

  // Opaque, application-level AES-256-GCM ciphertext (P8-D6). Never
  // decomposed into named columns (no `razorpayKeyId` field) — this is
  // what keeps the schema provider-shape-agnostic (P8-3 §5.3): a future
  // non-Razorpay adapter can store an entirely different credential shape
  // inside the same opaque blob. NOT read or written by this stage.
  credentialsEncrypted Bytes?
  credentialsUpdatedAt DateTime?

  connectedAt    DateTime?
  disabledAt     DateTime?
  disabledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // A plain, directly-expressible Prisma composite relation — NOT a
  // hand-added-SQL case. `Store` already carries `@@unique([tenantId,
  // id])`, added specifically ("supporting index for StoreSetting's
  // composite ownership FK") for exactly this P4-D3 pattern;
  // `PaymentAccount` is simply the next consumer of an index that already
  // exists for this purpose. `payment_accounts` is a table created in
  // THIS SAME migration, so this FK carries no G-19 restriction at all
  // (same "newInThisFile" exemption `SubscriptionEvent`'s own comment
  // documents) — unlike the plain, unconstrained `paymentAccountId`
  // columns added above to the four PRE-EXISTING commerce tables.
  store Store @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([storeId, provider])
  @@index([tenantId])
  @@index([status])
  @@map("payment_accounts")
}

// Checkout dedup — claimed via INSERT...ON CONFLICT DO NOTHING (§13.G).
model IdempotencyKey {
  id            String   @id @default(uuid())
  key           String   @unique
  userId        String
  endpoint      String
  resultOrderId String?  @unique
  expiresAt     DateTime

  tenantId   String
  customerId String?

  createdAt DateTime @default(now())

  user        User   @relation(fields: [userId], references: [id])
  resultOrder Order? @relation(fields: [resultOrderId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@map("idempotency_keys")
}

// Transactional outbox — inserted only in the same TXN as the state change
// it announces (§12.2).
model OutboxEvent {
  id            String            @id @default(uuid())
  eventType     OutboxEventType
  aggregateType String
  aggregateId   String
  eventKey      String            @unique
  payload       Json
  status        OutboxEventStatus @default(PENDING)

  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lastError   String?
  processedAt DateTime?

  tenantId String?

  createdAt DateTime @default(now())

  @@index([status, availableAt])
  @@index([tenantId])
  @@map("outbox_events")
}

// ─── Admin config ───────────────────────────────────────────────────────

// Small admin-editable config (flat shipping fee, etc.) — no shipping-rules
// engine in MVP (§15).
model AppSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ─── Reviews (Phase 10, docs/architecture/PHASE-10-PROPOSAL.md Part A) ────

enum ReviewStatus {
  PUBLISHED
  REJECTED
  REMOVED
}

// One review per (product, user) — the unique constraint below, not just
// app-level logic (§1.1/R6). `orderItemId` is the verified-purchase anchor
// (§1.1/R1/R4): the exact OrderItem, on a DELIVERED order, that proves this
// user bought this specific product — never trusted from the client, always
// resolved server-side (ReviewsService.findEligibleOrderItem). Anchoring on
// `orderItemId` rather than `orderId` matters because a single order can
// contain items for several different products; `orderId` alone would let a
// review of Product B piggyback on an order that only actually contained
// Product A. `status` defaults PUBLISHED (§1.5/R3 — publish immediately,
// moderate after the fact) but exists from day one so pre-moderation is a
// one-line default change later, not a migration.
model Review {
  id          String       @id @default(uuid())
  productId   String
  userId      String
  orderItemId String
  rating      Int
  bodyText    String?
  status      ReviewStatus @default(PUBLISHED)

  tenantId   String
  storeId    String?
  customerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([productId, userId])
  @@index([productId])
  @@index([status])
  @@index([tenantId])
  @@index([storeId])
  @@index([customerId])
  @@map("reviews")
}

// ─── Coupons (Phase 10, docs/architecture/PHASE-10-PROPOSAL.md Part B) ────

enum CouponType {
  PERCENTAGE
  FLAT_AMOUNT
  FREE_SHIPPING
}

enum CouponScopeType {
  STORE_WIDE
  CATEGORY
}

// Admin-defined discount codes. `code` always stored uppercase (mirrors
// users.email's always-lowercase convention) — case-insensitive matching
// by construction, no runtime UPPER()/LOWER() needed. `code`/`type` are
// immutable after creation — only limits/dates/isActive/description are
// admin-editable (UpdateCouponDto) — same "exactly one path changes this"
// discipline products.isActive already applies via the dedicated
// deactivate/reactivate endpoints rather than a general PATCH field.
// `usedCount` is the atomic-CAS counter (§2.6) — claimed via
// `UPDATE ... WHERE usageLimitTotal IS NULL OR usedCount < usageLimitTotal
// RETURNING id`, never check-then-increment, same pattern as
// OrdersService.generateOrderNumber's counter row.
model Coupon {
  id                String          @id @default(uuid())
  code              String
  type              CouponType
  percentageOff     Int?
  flatAmountOff     Decimal?        @db.Decimal(10, 2)
  scopeType         CouponScopeType
  categoryId        String?
  minOrderValue     Decimal?        @db.Decimal(10, 2)
  usageLimitTotal   Int?
  usageLimitPerUser Int?            @default(1)
  usedCount         Int             @default(0)
  firstOrderOnly    Boolean         @default(false)
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean         @default(true)
  description       String?
  createdByAdminId  String

  tenantId String
  storeId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdByAdmin User          @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  usages         CouponUsage[]
  orders         Order[]

  @@index([isActive])
  @@index([tenantId])
  @@index([storeId])
  @@map("coupons")
}

// Per-use audit ledger, backs the per-user usage-limit check — a plain
// COUNT(*) WHERE couponId=$ AND userId=$ query (§2.6), not its own CAS:
// the checkout transaction's own `SELECT cart ... FOR UPDATE` already
// serializes a single user's concurrent checkout attempts, so this table
// only ever needs to be read consistently inside that same transaction,
// never separately locked. Inserted only once the Order it belongs to
// exists (orderId is NOT NULL) — necessarily after `coupons.usedCount`'s
// CAS claim already succeeded earlier in the same transaction, never
// before it and never without it. Append-only, no updatedAt, same
// audit-log spirit as OrderStatusHistory.
model CouponUsage {
  id                    String  @id @default(uuid())
  couponId              String
  userId                String
  orderId               String  @unique
  discountAppliedAmount Decimal @db.Decimal(10, 2)

  tenantId   String
  storeId    String?
  customerId String?

  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId, userId])
  @@index([tenantId])
  @@index([storeId])
  @@index([customerId])
  @@map("coupon_usages")
}

// ═══════════════════════════════════════════════════════════════════════════
// SaaS Foundation — Phase 1
//   Master Plan §7 · PHASE-0-DECISION-RESOLUTION-AND-PHASE-1-SPEC.md §B.2–B.8
//   Permitted by docs/saas/ACR-001-SUPERSEDE-BLUEPRINT-V1.2.md (approved).
//
// ADDITIVE, NON-ENFORCING. These models are the tenant / store / membership
// ownership roots plus the plan / subscription shells. In Phase 1 NOTHING here
// is read for authorization, tenant scoping, billing, or domain resolution —
// those are Phases 2, 3, 5, 7 and 9 respectively. No existing model or column
// is changed by Phase 1. Enum value sets ratified by decision G-5 (verbatim for
// TenantRole and SubscriptionStatus).
// ═══════════════════════════════════════════════════════════════════════════

// Tenant-specific role, carried on TenantMembership — never a flag on User
// (frozen SaaS §5). Ratified verbatim (G-5). NOT read for authorization in
// Phase 1 — that is Phase 2's permission layer.
enum TenantRole {
  OWNER
  ADMIN
  STAFF
  VIEWER
}

// Tenant lifecycle. Ratified (G-5). PENDING_DELETION -> DELETED is a
// controlled, audited, reversible-until-purge process (frozen SaaS §18) — in
// Phase 1 only the state exists, there is no lifecycle logic.
enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
}

// Store lifecycle. Ratified (G-5). Distinct from TenantStatus and from
// SubscriptionStatus (frozen SaaS §12: "subscription status != store status").
enum StoreStatus {
  ACTIVE
  DISABLED
  DRAFT
}

// TenantMembership lifecycle. Ratified (G-5). INVITED = pending team
// invitation; the invite/accept flow is Phase 5.
enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

// StoreDomain verification state. Ratified (G-5). The verification *mechanism*
// and host -> store -> tenant runtime resolution are Phase 9; Phase 1 has the
// state only.
enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

// SaaS subscription state — the 7 frozen states, no additions (frozen SaaS §7;
// ratified verbatim, G-5). Billing-provider coupling is Phase 7.
enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

// Phase 7 Stage 1 (docs/saas/DECISIONS.md P7-D1) — `SubscriptionEvent.type`.
// One value per semantic action the ratified transition matrix requires;
// NOT a 1:1 mirror of `SubscriptionStatus` (several statuses are reached
// by more than one kind of event, e.g. `ACTIVE` via `activated`,
// `resumed`, or `reactivated` depending on which state it came from and
// why). A brand-new table (`subscription_events`), so this enum and the
// model below carry no G-19 restriction — see that model's own comment.
//
// Phase 7 Stage 2 (P7-D2 Part C) considered, and deliberately did NOT
// add, a dedicated `cancellation_scheduled` value here: extending this
// enum requires `ALTER TYPE ... ADD VALUE` on a type created by an
// EARLIER migration, which `migration-safety.spec.ts`'s additive-only
// guard (G-10) rejects outright for any non-legacy migration (its final
// fallback rule accepts only `CREATE ...`/`ALTER TABLE` in the shapes it
// already recognizes — `ALTER TYPE` matches neither and is rejected as
// "Unexpected non-additive statement"). The one existing
// `WebhookEventStatus` `ADD VALUE 'FAILED'` precedent predates that
// guard's rule and is grandfathered by filename, not by a general
// allowance — extending the guard to permit this shape is a separate,
// significant, not-yet-ratified architectural decision (the same kind of
// dedicated guard extension P4-D2/P4-D3 each required their own record
// for), out of scope for this stage. `SubscriptionService
// .scheduleCancellation()` therefore reuses the EXISTING `cancelled`
// value for its own scheduling-moment event (disambiguated by
// `toStatus` staying unchanged and a `metadata.scheduled: true` flag) —
// see that method's own comment.
enum SubscriptionEventType {
  created
  activated
  upgraded
  downgrade_scheduled
  downgrade_applied
  payment_failed
  paused
  resumed
  cancelled
  expired
  reactivated
}

// The top-level isolation and billing boundary — one merchant business on the
// shared platform. Every tenant-owned row (Phase 4 onward) will resolve to
// exactly one Tenant. A Tenant.id is NEVER an authorization boundary on its
// own (frozen SaaS invariant 1): it is reached only via an authenticated
// TenantMembership (merchant console) or Domain -> Store -> Tenant resolution
// (storefront) — Phase 1 adds no guard. Per decision D3-A the existing
// deployment becomes "Tenant #1", an ordinary tenant with no implicit
// privileges; the tenant display name is a Phase 4 input (D3 Decision Log), so
// Phase 1 identifies a tenant by `slug` only.
model Tenant {
  id     String       @id @default(uuid())
  slug   String       @unique
  status TenantStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stores            Store[]
  memberships       TenantMembership[]
  storeDomains      StoreDomain[]
  subscription      Subscription?
  // SaaS Identity (Phase 2a) — back-relation only; adds NO column to `tenants`.
  // `Customer.tenantId` is denormalized (isolation defence-in-depth); the
  // same-store composite FK is Phase 4 hardening (decision P2-D12).
  customers         Customer[]
  // Phase 4 (W3) — back-relation only; adds NO column to `tenants`.
  tenantCounters    TenantCounter[]
  // Phase 5 (W2) — back-relations only; add NO column to `tenants`.
  platformAuditLogs PlatformAuditLog[]
  tenantAuditLogs   TenantAuditLog[]
  // Phase 5 (W6) — back-relation only; adds NO column to `tenants`.
  supportSessions   SupportSession[]
  // Phase 5 (W9) — back-relation only; adds NO column to `tenants`.
  tenantSettings    TenantSetting[]
  // Phase 6 (W1) — back-relations only; add NO column to `tenants`.
  usage             Usage[]
  entitlementOverrides TenantEntitlementOverride[]
  // Phase 8 — back-relation only; adds NO column to `tenants`.
  paymentAccounts PaymentAccount[]

  @@index([status])
  @@map("tenants")
}

// One storefront belonging to a Tenant — the unit the shared storefront engine
// renders (Phase 12). v1 baseline: exactly one primary Store per Tenant,
// DB-enforced by a partial unique index Prisma's DSL cannot express natively:
//
//   CREATE UNIQUE INDEX "stores_tenant_primary_unique"
//     ON "stores" ("tenantId") WHERE "isPrimary" = true;
//
// It is hand-added to the Phase 1 migration.sql, exactly like the existing
// payment_attempts_order_captured_unique. Prisma will not remove a manually
// added SQL statement on later migrations unless a schema change to this model
// reintroduces it. Multiple stores per tenant stay future-compatible: Store is
// a first-class table with its own id; `isPrimary` is a flag, not a schema
// shortcut. Branding / a keyed StoreSetting are deferred to Phase 4/12
// (spec §B.3) — `name` is the only display field in Phase 1.
model Store {
  id        String      @id @default(uuid())
  tenantId  String
  slug      String
  name      String
  status    StoreStatus @default(DRAFT)
  isPrimary Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  domains   StoreDomain[]
  // SaaS Identity (Phase 2a) — back-relation only; adds NO column to `stores`.
  // The FK column `storeId` lives on `customers`. Customer = store-scoped
  // storefront identity (decision D5-a).
  customers Customer[]
  // Phase 5 (W9) — back-relation only; adds NO column to `stores`. The
  // StoreSetting model this file's own comment above anticipated
  // ("Branding / a keyed StoreSetting are deferred to Phase 4/12").
  storeSettings StoreSetting[]
  // Phase 8 — back-relation only; adds NO column to `stores`.
  paymentAccounts PaymentAccount[]

  @@unique([tenantId, slug])
  // Phase 5 (W9) — supporting index for StoreSetting's composite ownership
  // FK (`store_settings(tenantId, storeId) -> stores(tenantId, id)`,
  // hand-added to that model's own migration, same convention every Phase
  // 4 W6 composite ownership FK already uses) — exactly the same
  // "(scopeCol, id) is not inferred from the id-only PRIMARY KEY"
  // prerequisite that migration documents for 8 other tables. This index
  // itself IS representable in Prisma's own DSL (a plain compound
  // @@unique, no WHERE clause) — only the FK that consumes it is not.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("stores")
}

// A hostname bound to a Store. `hostname` is GLOBALLY unique — a hostname
// resolves to exactly one store -> one tenant (frozen SaaS §10). `tenantId` is
// denormalized for isolation defence-in-depth (spec §B.6) and is FK-enforced.
// Exactly one primary domain per store, DB-enforced by a partial unique index
// hand-added to the Phase 1 migration.sql:
//
//   CREATE UNIQUE INDEX "store_domains_store_primary_unique"
//     ON "store_domains" ("storeId") WHERE "isPrimary" = true;
//
// The verification *mechanism* and host -> store -> tenant runtime resolution
// are Phase 9 — Phase 1 stores the model + state only.
model StoreDomain {
  id                 String                   @id @default(uuid())
  storeId            String
  tenantId           String
  hostname           String                   @unique
  isPrimary          Boolean                  @default(false)
  verificationStatus DomainVerificationStatus @default(PENDING)
  verificationToken  String?
  verifiedAt         DateTime?

  createdAt DateTime @default(now())

  store  Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([tenantId])
  @@map("store_domains")
}

// The join between a global (platform/merchant) User and a Tenant, carrying
// the user's tenant-specific role. Merchant authorization lives HERE, never as
// a flag on User (frozen SaaS §5). A storefront Customer (decision D5-a,
// Phase 2) will NEVER hold a membership. `role` and `status` are DATA ONLY in
// Phase 1 — nothing reads them for authorization (Phase 2's permission layer).
// `invitedByUserId` is SET NULL (incidental reference, like
// order_status_history.changedByUserId).
model TenantMembership {
  id              String           @id @default(uuid())
  userId          String
  tenantId        String
  role            TenantRole
  status          MembershipStatus @default(INVITED)
  invitedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User   @relation("TenantMembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy User?  @relation("TenantMembershipInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  // Phase 5 (W2) — back-relation only; adds NO column to `tenant_memberships`.
  // A TenantAuditLog.actorMembershipId row's actor (SET NULL if the
  // membership is later suspended/removed — the log entry survives).
  tenantAuditLogs TenantAuditLog[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

// Platform-owned catalogue of subscription plans. Phase 1 shell, expanded by
// Phase 6 W1 (ratified Phase 6 Design Gate/Ratification — see
// docs/saas — Plan Lifecycle). `key` is one of {free, starter, growth,
// business, enterprise} — a String, not an enum (it is not among the six
// ratified Phase 1 enums, G-5). PlanFeature / PlanLimit / Usage /
// EntitlementService are Phase 6 W1 (catalogue + schema) and W2
// (enforcement) — see the two new models below and `platform/platform-plans/`.
//
// Phase 6 W1 — plan lifecycle (`isActive`): ACTIVE (`true`, default) is
// selectable for a NEW subscription, subject to `isPublic`; INACTIVE/
// ARCHIVED (`false`) is never selectable for a new subscription but an
// EXISTING `Subscription` referencing it keeps resolving normally —
// `isActive` is consulted only by "can a NEW subscription pick this plan",
// never by entitlement resolution itself (that is `EntitlementService`'s
// own W2 concern, and W2 must not read `Plan.isActive` either — an
// archived plan's `PlanFeature`/`PlanLimit` rows are themselves untouched
// by archiving). `isPublic` stays fully independent of `isActive`, exactly
// as it already was: a plan can be `isActive=true, isPublic=false`
// (Enterprise-style, SUPER_ADMIN-assigned only) or `isActive=false` (fully
// retired) — the two flags are never merged into one.
//
// Hard delete: unchanged and unextended — `Subscription.plan`'s existing
// `onDelete: Restrict` (below) already makes a `Plan` referenced by ANY
// `Subscription` (including a historical/cancelled one — the `Subscription`
// row itself is never deleted, so the FK reference persists) undeletable at
// the database level. Deleting a genuinely unused `Plan` (zero
// `Subscription` rows, ever) is permitted, and Cascades its own
// `PlanFeature`/`PlanLimit` children (their own `onDelete: Cascade`, since
// they have no independent meaning once their parent `Plan` is gone) —
// never a `Subscription`, never any other tenant data.
model Plan {
  id       String  @id @default(uuid())
  key      String  @unique
  name     String
  isPublic Boolean @default(true)

  // Phase 6 W1 additions. Nullable at the DB level, NOT NULL-with-DEFAULT
  // at the design/application level — a deliberate, discovered, and now
  // formally ratified deviation (docs/saas/DECISIONS.md, record P6-D1)
  // from the ratified spec's literal `Boolean @default(true)` syntax,
  // forced by `migration-safety.spec.ts`'s G-19 rule: the ONLY permitted
  // way to add a column to an existing (not-created-in-this-migration)
  // table is a single, purely nullable ADD COLUMN with no DEFAULT and no
  // NOT NULL — there is no guard exemption for a defaulted/NOT-NULL
  // addition, and the one two-phase mechanism this repo already has for
  // that (P4-D2's CHECK-NOT-VALID/VALIDATE/SET-NOT-NULL trio) is hard-
  // scoped by name to 20 pre-approved `(table, "tenantId")` pairs from an
  // already-closed effort — not a general-purpose mechanism to extend.
  // `null` is therefore a real, reachable value for the sole pre-existing
  // `Plan` row until the W1 backfill script runs, and application code
  // MUST coalesce (`?? true` / `?? 0` / `?? false`) everywhere these
  // fields are read — never assume non-null, including at the query
  // level: `PlatformPlansService.listPlans()` deliberately does NOT sort
  // on the raw `sortOrder` column (Postgres's NULLS LAST default for ASC
  // would misplace a legacy-null row relative to its coalesced `0`
  // meaning) — it sorts in memory on the coalesced value instead (P6-D1).
  // Every row created by the W1 platform service, `seed-tenant-bootstrap
  // .ts`, and `dev-scratch-seed-phase2b-equivalent.ts` writes a real,
  // non-null value for all three fields explicitly (none of these leaves
  // them blank), so `null` is only ever a legacy-row artifact, not a
  // normal state for a plan created through any current code path.
  isActive           Boolean?
  sortOrder          Int?
  isEnterpriseCustom Boolean?

  createdAt DateTime @default(now())

  subscriptions Subscription[]
  planFeatures  PlanFeature[]
  planLimits    PlanLimit[]

  @@map("plans")
}

// Exactly one primary subscription per Tenant (`tenantId` unique). Phase 1
// shell: id, tenantId, planId, status (7 frozen states), period bounds,
// createdAt only (spec §B.6). Lifecycle is written only by the Platform
// Control Plane / billing (Phase 7); billing-provider coupling,
// SubscriptionEvent and SaasInvoice are Phase 7. Column default is PENDING
// (repo convention — enums default to their initial state); the Phase 1
// bootstrap seed creates a Free/ACTIVE subscription explicitly.
model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique
  planId             String
  status             SubscriptionStatus @default(PENDING)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // Phase 7 (Stage 1, docs/saas/DECISIONS.md P7-D1) additions below.
  // `subscriptions` is a table created by an EARLIER migration, so
  // migration-safety.spec.ts's G-19 rule applies exactly as it already did
  // to `Plan.isActive`/`sortOrder`/`isEnterpriseCustom` (P6-D1): the ONLY
  // permitted change is a single, purely nullable `ADD COLUMN`, no
  // `DEFAULT`, no `NOT NULL` — one column per statement. P7-D1's literal
  // schema text (`cancelAtPeriodEnd Boolean @default(false)`, `updatedAt
  // DateTime @updatedAt`) is therefore implemented here as nullable-with-
  // no-DB-default, application-level-coalesced, exactly mirroring P6-D1's
  // own resolution of the identical conflict — NOT a new decision, the
  // same already-ratified pattern applied to a new table. Application code
  // reading these fields MUST coalesce (`?? false` for
  // `cancelAtPeriodEnd`) and MUST NOT assume non-null.
  providerCustomerId     String? @unique
  providerSubscriptionId String? @unique
  // Nullable, no DB default (G-19) — coalesce to `false` at every read
  // site, same discipline as Plan.isActive/etc. (P6-D1).
  cancelAtPeriodEnd Boolean?
  trialEndsAt       DateTime?
  // Plain column, deliberately NO Prisma `@relation` / DB foreign key.
  // P7-D1 ratifies "pendingPlanId references Plan… via an explicit,
  // distinctly-named Prisma relation… restrictive deletion" — but a real
  // FK is `ALTER TABLE "subscriptions" ADD CONSTRAINT … FOREIGN KEY`,
  // which migration-safety.spec.ts rejects outright for a pre-existing
  // table (only a bare nullable ADD COLUMN, an RLS toggle, or the
  // already-closed, byname-scoped P4-D3 composite-ownership-FK exemption
  // are permitted — there is no general "add a new FK to an existing
  // table" mechanism, and extending the guard to add one is a separate,
  // out-of-scope architectural decision, not made here). The referential
  // integrity P7-D1 asks for is therefore enforced at the APPLICATION
  // layer instead (`SubscriptionService` validates `pendingPlanId` against
  // a real `Plan.id` — same `assertPlanExists`-style check
  // `platform-plans.service.ts` already uses — before ever writing it),
  // not at the database layer, for Stage 1. Flagged explicitly in the W1
  // (Stage 1) implementation report as a deviation from P7-D1's literal
  // text, not a silent decision. A future record could add the real FK
  // via its own P4-D3-style guard extension if that's ever required.
  pendingPlanId String?
  graceEndsAt   DateTime?
  // Nullable, no DB default, no `@updatedAt` magic (Prisma's `@updatedAt`
  // combined with a genuinely additive nullable column is unverified
  // against this repo's own migration-safety guard output — not risked;
  // see Step 3's generated SQL). `SubscriptionService`/the state machine
  // explicitly sets this on every write it makes; a row this code has
  // never touched remains `null`, exactly like a legacy `Plan` row's
  // nullable columns before the P6-D1 backfill ran.
  updatedAt DateTime?

  // Phase 7 — Cancellation Retention + Unscheduling wave (docs/saas/DECISIONS.md
  // P7-D3 Part D). Same G-19-nullable-additive shape as `graceEndsAt` above —
  // no DEFAULT, no NOT NULL, one column, one action. Set ONLY by
  // `SubscriptionService.cancel()`, at the exact moment a subscription
  // actually becomes `CANCELLED` (never by `scheduleCancellation()` — P7-D3
  // Part D: "do not start retention during merely scheduling cancellation").
  // This single write site automatically covers both an immediate
  // cancellation and an at-period-end cancellation applied later by
  // `reconcilePeriod()` (both call the same `cancel()`). Never cleared by
  // any code path today (a `CANCELLED -> ACTIVE` reactivation leaves it
  // stale-but-inert, since the row no longer matches the expiration
  // scheduler's own `status = 'CANCELLED'` filter — see that scheduler's
  // own comment). Consumed by `SubscriptionSchedulerService
  // .runCancellationExpiration()` to find rows eligible for
  // `SubscriptionService.expire()`; `expire()` itself does not read this
  // field at all, exactly as `exhaustGrace()` never reads `graceEndsAt`.
  retentionEndsAt DateTime?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  events SubscriptionEvent[]

  @@index([planId])
  @@map("subscriptions")
}

// Phase 7 Stage 1 (docs/saas/DECISIONS.md P7-D1) — append-only subscription
// lifecycle history. A brand-new table: unlike `Subscription` above, this
// carries NO G-19 restriction at all — `ALTER TABLE "subscription_events"
// ADD CONSTRAINT …` targets a table created in THIS SAME migration, which
// migration-safety.spec.ts's guard explicitly permits (`newInThisFile`),
// so real foreign keys are used here without the `pendingPlanId` workaround
// `Subscription` needed.
//
// `fromPlanId`/`toPlanId` are deliberately PLAIN denormalized snapshot
// columns (no `@relation` to `Plan`) — same precedent as
// `OrderStatusHistory.fromStatus`/`toStatus` (plain enum values, no
// relation) and `OrderStatusHistory.tenantId` (plain indexed column, no
// `Tenant` relation): a historical audit row records what a plan id WAS at
// the moment of the event, and must remain valid/readable even in the
// hypothetical future where that Plan row's own lifecycle diverges — an
// audit trail is a snapshot, not a live reference.
//
// `providerEventId` is explicitly NOT unique (P7-D1 Part F) — provider-
// event deduplication belongs to the separate `BillingWebhookEvent` table
// below (D7 — implemented in the D7 SaaS Billing Webhooks wave; see that
// model's own comment), never to this table. This model is domain history
// only: no update/delete method is ever exposed for it (append-only by
// construction, same discipline as `PlatformAuditLog`/`TenantAuditLog`),
// and no code anywhere may use it as an idempotency/dedup store.
model SubscriptionEvent {
  id             String                @id @default(uuid())
  subscriptionId String
  tenantId       String
  type           SubscriptionEventType
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  fromPlanId     String?
  toPlanId       String?
  providerEventId String?
  metadata       Json                  @default("{}")

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([subscriptionId])
  @@index([tenantId])
  @@index([providerEventId])
  @@map("subscription_events")
}

// Phase 7 — D7 SaaS Billing Webhooks wave (docs/saas/DECISIONS.md P7-D3
// Part B — the two-table design ratified there). A brand-new table, exactly
// like `SubscriptionEvent` above: no G-19 restriction applies to anything
// in it.
//
// Deliberately SEPARATE from the commerce `WebhookEvent`/`webhook_events`
// table (frozen SaaS invariant 6: SaaS subscription billing and merchant
// commerce payments are separate) — never merged, never shares a secret or
// a route. Mirrors `WebhookEvent`'s own shape closely (same RECEIVED /
// PROCESSED / PROCESSING_FAILED / IGNORED / FAILED status vocabulary, same
// attempts/availableAt/lastError/processedAt retry bookkeeping) but is its
// OWN enum/table — reusing `WebhookEventStatus`'s name here would silently
// couple a future commerce-only enum change to this SaaS-only table.
//
// Platform-scoped by design (P7-D3 Part B: "never trust tenantId from
// webhook payload"): deliberately NO `tenantId` column. Tenant is resolved
// downstream, at PROCESSING time, via `Subscription.providerSubscriptionId`/
// `providerCustomerId` (both already `@unique`) — never stored as an
// unverified guess on the raw ingested row.
//
// Deliberately NO foreign key to `Subscription`: an event may legitimately
// arrive before, or reference, a subscription this system does not (or no
// longer) recognize (a provider retry, a race, a misconfigured endpoint) —
// exactly the case the two-phase ingestion/processing split exists to
// tolerate; a hard FK would force ingestion to fail-fast on the one case
// this design is built to absorb gracefully (the processor marks such a
// row IGNORED, never crashes).
//
// `providerEventId` IS unique here (unlike `SubscriptionEvent.providerEventId`
// above) — this table, not `SubscriptionEvent`, is the sole dedup boundary
// (P7-D3 Part B: "providerEventId is unique for BillingWebhookEvent
// deduplication"). `payload` retains the full normalized event
// (`{providerEventId, type, payload}` — see `BillingProvider.parseWebhook`)
// verbatim, for replay.
model BillingWebhookEvent {
  id              String                    @id @default(uuid())
  providerEventId String                    @unique
  payload         Json
  status          BillingWebhookEventStatus @default(RECEIVED)

  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lastError   String?
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
  @@map("billing_webhook_events")
}

// ═══════════════════════════════════════════════════════════════════════════
// SaaS Identity — Phase 2a
//   Master Plan §8 · docs/saas/PHASE-2-DECISION-RESOLUTION-AND-SPEC.md §C
//   Decisions P2-D1/P2-D2 (PlatformRole, above), P2-D11 (isActive-only lifecycle),
//   P2-D12 (tenantId plain column now), G-11/G-12 — docs/saas/DECISIONS.md v1.2.
//
// ADDITIVE. Phase 2a adds the store-scoped storefront-identity root only.
// DEFERRED, NOT here: customer authentication runtime, CustomerRefreshToken
// table, /storefront/auth/* — all Phase 9/12 (decision P2-D7 deferred customer
// auth entirely; there is no pre-Phase-9 store-resolution mechanism). NOT here:
// any `customerId` column on an existing commerce table, any FK re-pointing —
// Phase 4. Customer ROWS are created in Phase 2a only by the dev/test fixture;
// the production role='CUSTOMER' -> Customer backfill is Phase 2b (gated on
// D2 + D8 + G-16).
// ═══════════════════════════════════════════════════════════════════════════

// Store-scoped storefront shopper identity (decision D5-a). Keyed by
// (storeId, email): the same email at two stores is two distinct Customers
// (frozen SaaS — "customer identity is store-scoped"). A Customer NEVER holds
// a TenantMembership — there is no FK path from Customer to User or to a
// membership, so merchant and customer identity are structurally separate
// (frozen SaaS §5/§13; Master Plan §8 KEY RISKS). `tenantId` is denormalized
// for isolation defence-in-depth and FK-enforced; the same-store composite FK
// ((storeId, tenantId) must agree) is Phase 4 hardening (decision P2-D12) —
// Phase 2a stores it as a plain FK column, exactly as Phase 1 did for
// Store/StoreDomain. The auth fields mirror `User` but are inert until the
// Phase 9/12 customer auth runtime. `isActive` is the only lifecycle field —
// no CustomerStatus enum (decision P2-D11).
model Customer {
  id       String @id @default(uuid())
  storeId  String
  tenantId String
  email    String

  passwordHash String

  tokenVersion           Int       @default(0)
  failedLoginAttempts    Int       @default(0)
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?

  isActive Boolean @default(true)

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  phone        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Phase 5 (W2) — back-relation only; adds NO column to `customers`.
  tenantAuditLogs TenantAuditLog[]

  @@unique([storeId, email])
  @@index([storeId])
  @@index([tenantId])
  @@map("customers")
}

// ═══════════════════════════════════════════════════════════════════════════
// Phase 4 (W3) — Sequential per-tenant numbering
//   Master Plan W3 · docs/saas/PHASE-4-START-GATE-AND-IMPLEMENTATION-SPEC.md
//   Decision D10 (RESOLVED — BUSINESS DECISION, docs/saas/DECISIONS.md):
//   sequential tenant-scoped order/invoice numbering; existing numbers are
//   never rewritten; new numbers use TenantCounter with an atomic per-tenant
//   counter; no financial-year reset required by the current business
//   decision.
//
// Brand-new, empty table — a real @relation to Tenant is safe here (unlike
// the plain scalar tenantId/storeId/customerId columns added above to
// pre-existing commerce tables, which stay relation-less until W6 composite
// FKs). `key` namespaces the counter per numbering series on a tenant, e.g.
// "order_number" / "invoice_number" (the counter *consumer* — W7 — decides
// the exact key set; this table only provides the atomic increment
// primitive). The atomic claim is `UPDATE ... SET value = value + 1
// RETURNING value` (or an upsert equivalent), never check-then-increment —
// same discipline as coupons.usedCount and orders.orderNumber's existing
// counter pattern.
// ═══════════════════════════════════════════════════════════════════════════
model TenantCounter {
  id       String @id @default(uuid())
  tenantId String
  key      String
  value    Int    @default(0)

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@map("tenant_counters")
}

// ═══════════════════════════════════════════════════════════════════════════
// Phase 5 (W2) — Audit foundation
//   Master Plan §11 (Platform Admin / Tenant Admin) · Phase 5 Decision
//   Ratification, decisions P5-D3 / P5-D4A (this session).
//
// Two frozen, append-only models — never a generic AuditLog (decision
// P5-D3 explicitly rejects that design). No application service ever calls
// `.update()`/`.delete()`/`.upsert()` on either model (enforced by
// backend/src/common/audit/audit.append-only.spec.ts's static scan).
// Writes always go through AuditService.logPlatformAction /
// .logTenantAction, always inside the CALLER's own transaction — the exact
// convention NotificationsService.enqueueOutboxEvent already established
// for OutboxEvent, and OrderStatusHistory's own append-only precedent
// before that.
// ═══════════════════════════════════════════════════════════════════════════

// Platform-scoped audit trail — every SUPER_ADMIN action on /platform/*
// (Phase 5 W3 onward). `tenantId` is nullable: present only when the
// action touched a specific tenant (e.g. suspend/resume, opening a
// SupportSession); absent for purely platform-internal actions.
// `justification` is required BY APPLICATION LOGIC for any action that
// reaches into a specific tenant's context (§11 SECURITY IMPACT) — the
// column itself stays nullable since not every platform action needs one.
model PlatformAuditLog {
  id            String  @id @default(uuid())
  actorUserId   String
  action        String
  targetType    String
  targetId      String
  tenantId      String?
  justification String?
  metadata      Json
  ip            String

  createdAt DateTime @default(now())

  actor  User    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([tenantId, createdAt])
  @@map("platform_audit_logs")
}

// Tenant-scoped general audit trail — settings/team/coupon/catalog changes
// and any other sensitive Tenant Control Plane mutation (§11: "the general
// one for settings/team/coupon/catalog changes" — OrderStatusHistory
// remains the separate, unchanged, order-specific trail). Read is always
// filtered by the caller's own tenantId; no route may return another
// tenant's rows (frozen SaaS invariant 5).
//
// Exactly one of `actorMembershipId` / `actorCustomerId` is set, per the
// acting identity — both SET NULL on their referenced row's removal
// (incidental reference, matching order_status_history.changedByUserId's
// existing convention), so the log entry survives even if the acting
// membership/customer is later suspended or removed.
//
// `viaSupportSessionId` (decision P5-D4A) is a forward reference to the
// SupportSession model Phase 5 W6 introduces — NOT a relation yet (that
// model does not exist as of W2; see the W2 implementation report for why
// a real FK is deliberately deferred rather than worked around). When set,
// it identifies that this action occurred through a platform-granted
// SupportSession rather than an ordinary membership, and which one.
model TenantAuditLog {
  id                  String  @id @default(uuid())
  tenantId            String
  actorMembershipId   String?
  actorCustomerId     String?
  action              String
  targetType          String
  targetId            String
  metadata            Json
  viaSupportSessionId String?

  createdAt DateTime @default(now())

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorMembership TenantMembership? @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)
  actorCustomer   Customer?         @relation(fields: [actorCustomerId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("tenant_audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// Phase 5 (W6) — SupportSession
//   Master Plan §11 (Platform Admin / Tenant Admin) · Phase 5 decisions
//   P5-D4 / P5-D4A / P5-D8 (this session's Phase 5 ratification).
//
// A platform-initiated, SUPER_ADMIN-created, single-tenant-scoped,
// explicitly-justified, explicitly-expiring, revocable grant that a future
// (now: current) request can present to operate within one tenant's context
// without a TenantMembership (frozen SaaS invariant 4: platform authority
// stays structurally separate from tenant membership — this model is the
// one deliberate, fully-audited exception, not a loophole in that
// invariant).
//
// No `status` column — ACTIVE/REVOKED/EXPIRED is deliberately DERIVED at
// check time from `revokedAt`/`expiresAt` (support-session-context.guard.ts,
// support-session.service.ts), never persisted, and never advanced by a
// background job (there is no cron/worker in this codebase and W6
// introduces none — expiration is enforced live, on every request that
// presents a session, exactly like `RefreshToken.expiresAt`/`revokedAt`
// below already do for a completely different credential).
//
// `grantedPermissions` stores plain strings, not a second permission
// catalogue — every value is validated against the existing, ratified
// `PERMISSIONS` catalogue (`auth/permissions/permission.ts`) at creation
// time (`support-session.service.ts`); nothing here defines a new
// permission or a new role. At request time this array is a CEILING
// (`PermissionsGuard`), never a grant beyond what the underlying route
// already requires — see that guard's own header comment.
//
// No secret/token column: request-time identification is the caller's
// already-verified JWT identity (`AuthenticatedUser`, unchanged) plus this
// row's own `id` (a plain, non-secret UUID, exactly like every other
// resource id in this system) presented via a header and authorized by a
// server-side ownership + validity check
// (`common/tenant/support-session-context.guard.ts`) — not by treating the
// id itself as a bearer credential. See that guard's file header for the
// full reasoning and the W6 implementation report for why no new
// cryptographic token was introduced.
model SupportSession {
  id                 String    @id @default(uuid())
  tenantId           String
  createdByUserId    String
  justification      String
  grantedPermissions String[]
  expiresAt          DateTime
  revokedAt          DateTime?
  revokedByUserId    String?

  createdAt DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User   @relation("SupportSessionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy User?  @relation("SupportSessionRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("support_sessions")
}

// ═══════════════════════════════════════════════════════════════════════════
// Phase 5 (W9) — AppSetting tenant/store ownership (decision D11)
//   Master Plan §11 (Platform Admin / Tenant Admin).
//
// The original `AppSetting` model above (`@@map("app_settings")`) stays
// completely UNCHANGED and UNMIGRATED — it cannot be altered in place
// (migration-safety.spec.ts's additive-only guard has no exemption for a
// pre-existing table gaining a NOT NULL tenantId/storeId outside its own
// fixed, already-ratified W7 allowlist, and rightly so: extending that
// allowlist for a brand-new phase would weaken the exact discipline that
// guard exists to enforce). It continues to serve exactly one purpose
// after W9: `OrdersService.generateOrderNumber`'s platform-wide order
// counter (`order_number_counter`) — a deliberately platform-scoped
// identifier by original design, out of scope for this decision (see the
// W9 implementation report). `invoice_number_counter` (the OTHER counter
// that used to live in `app_settings`) is retired by this phase in favor
// of the already-existing `TenantCounter` model (Phase 4 W3/W4, decision
// D10) — its old `app_settings` row is left physically in place,
// untouched, but no longer read or written by any application code.
//
// Two new models replace the global key-value rows for the frozen D11
// key set — deliberately TWO separate models, not one mixed-ownership
// table: each ownership axis gets its own required (never nullable)
// scope column and a plain `@@unique`, sidestepping the SQL NULL-equality
// gotcha a single nullable-storeId table would have (two rows with
// storeId=NULL are NOT "duplicates" under standard unique-constraint NULL
// semantics, so a mixed model could not actually prevent two tenant-owned
// rows for the same key without a hand-written partial index). Which of
// the two a given key uses is decided once, centrally, by
// `app-setting.constants.ts`'s ownership classification — never inferred
// per-row, never client-selectable.
// ═══════════════════════════════════════════════════════════════════════════

model TenantSetting {
  id    String @id @default(uuid())
  tenantId String
  key      String
  value    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("tenant_settings")
}

// `tenantId` is denormalized alongside `storeId` (same convention
// `Customer.tenantId` already establishes — "isolation defence-in-depth")
// and cross-checked by a composite ownership FK
// (`store_settings(tenantId, storeId) -> stores(tenantId, id)`) — hand-added
// to this model's own migration, exactly like every Phase 4 W6 composite
// FK, since Prisma's relation DSL cannot represent a second FK to a table
// already related via a plain single-column FK (`store`, below). This is
// what makes "a Store-owned setting must not reference a Store belonging
// to another Tenant" a database-enforced invariant, not merely an
// application-layer promise.
model StoreSetting {
  id       String @id @default(uuid())
  tenantId String
  storeId  String
  key      String
  value    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, key])
  @@index([storeId])
  @@index([tenantId])
  @@map("store_settings")
}

// ═══════════════════════════════════════════════════════════════════════════
// Phase 6 (W1) — Entitlement engine schema + platform catalogue CRUD
//   Master Plan §12 (Phase 6 — Plans/Features/Limits/Usage); Phase 6 Design
//   Gate + Design Ratification (docs/saas — SaaS Monetization & Entitlements).
//
// W1 scope is schema + platform-side catalogue management ONLY. No
// enforcement exists yet — `EntitlementService`, `@RequireFeature`,
// `assertLimit`, and every Usage-incrementing call site are Phase 6 W2, not
// built here. `Plan.isActive` (added above) is likewise not consulted by
// anything in this migration's own models — archiving a plan is purely a
// "not selectable for a NEW subscription" flag until W2 exists to read it
// (and even then, W2 must not read it for entitlement RESOLUTION, only the
// platform-facing "can this plan still be assigned" check — see the `Plan`
// model's own comment above).
//
// This migration never writes to, and W1's application code never
// modifies, `Subscription.planId` or `Subscription.status` — those remain
// exclusively Phase 7's write surface (ratified Phase 6/Phase 7 boundary).
// ═══════════════════════════════════════════════════════════════════════════

// Feature/limit period split (ratified — never merged). PERSISTENT: a
// point-in-time count with no period rollover (e.g. how many products
// exist right now). BILLING_PERIOD: a count that resets to a fresh row
// every period (e.g. orders created this month) — the OLD period's `Usage`
// row is never deleted or rewritten, a new period is a new row (§ Usage
// model comment).
enum LimitPeriod {
  PERSISTENT
  BILLING_PERIOD
}

// Boolean (can/can't) capability grant for a Plan. Never merged with
// PlanLimit (ratified — ".. are never merged; both attach to Plan"). The
// actual feature-key catalogue is code-defined (mirrors
// `app-setting.constants.ts`'s allowlist pattern), not DB-editable — this
// table only ever holds a `(planId, featureKey)` -> `enabled` grant for
// keys the code-level catalogue already recognizes; the platform service
// validates `featureKey` against that catalogue before every write (W1
// scope), never accepting an arbitrary string.
model PlanFeature {
  id         String  @id @default(uuid())
  planId     String
  featureKey String
  enabled    Boolean @default(false)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("plan_features")
}

// Measurable (how much) grant for a Plan. `limitValue = NULL` means
// unlimited — the same NULL-is-unlimited convention this override model
// below reuses for `intValue`, so there is exactly one "unlimited"
// representation across the whole entitlement engine, never two. Same
// code-defined `limitKey` catalogue discipline as `PlanFeature.featureKey`.
model PlanLimit {
  id         String      @id @default(uuid())
  planId     String
  limitKey   String
  limitValue Int?
  period     LimitPeriod

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, limitKey])
  @@map("plan_limits")
}

// Tenant-owned, persisted (never derived) usage counter. `period` is the
// literal string `"PERSISTENT"` for a PlanLimit of period PERSISTENT, or a
// period stamp (e.g. `"2026-09"`) for a BILLING_PERIOD limit — so a new
// billing period is always a brand-new row, never an in-place reset, and
// historical per-period usage is retained for free. Incremented atomically
// (`INSERT ... ON CONFLICT (tenantId, limitKey, period) DO UPDATE SET
// count = count + 1`), the exact pattern already proven by `TenantCounter`
// (Phase 4 W3/W9) and `CouponsService`'s usedCount CAS — never a
// SELECT-then-UPDATE. W1 creates this table only; nothing in W1's own
// application code writes to it — the first real increment/decrement is
// Phase 6 W2's `assertLimit`.
model Usage {
  id       String @id @default(uuid())
  tenantId String
  limitKey String
  period   String
  count    Int    @default(0)

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, limitKey, period])
  @@map("usage")
}

// Per-tenant override of exactly one PlanFeature or PlanLimit value,
// REPLACING (never adding to) the plan's own value — the mechanism behind
// Enterprise custom deals without ever minting a one-off Plan row. Exactly
// one of `featureKey`/`limitKey` is set (enforced by a `CHECK` constraint
// hand-added to this model's own migration, the same "Prisma's DSL cannot
// express this, so it is hand-added to migration.sql and Prisma will never
// remove it" convention `Store.stores_tenant_primary_unique` and every
// composite ownership FK in this schema already establish) — a
// feature-shaped override carries `boolValue` (never `intValue`); a
// limit-shaped override carries `intValue` (`NULL` = unlimited, same
// convention as `PlanLimit.limitValue`; never `boolValue`). The
// application layer (the W1 platform service) additionally validates this
// before every write, so a caller gets a clean 400, not a raw constraint
// violation — but the CHECK is the actual authority.
//
// Revocation is soft (`revokedAt`/`revokedByUserId`) — an override is
// NEVER deleted or mutated in place once created; "updating" one means
// revoking it and creating a fresh replacement row, preserving the exact
// historical fact "this tenant had this override from X to Y" the same
// way this codebase's audit logs are append-only by construction. No
// `expiresAt` in W1 (deliberately deferred — see the Design Ratification's
// own Gap 2 record); a still-open override never automatically lapses.
model TenantEntitlementOverride {
  id       String  @id @default(uuid())
  tenantId String

  featureKey String?
  limitKey   String?
  boolValue  Boolean?
  intValue   Int?

  reason          String
  createdByUserId String
  revokedAt       DateTime?
  revokedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User   @relation("TenantEntitlementOverrideCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy User?  @relation("TenantEntitlementOverrideRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("tenant_entitlement_overrides")
}

